<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="nightSky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#030712" />
      <stop offset="60%" stop-color="#0f172a" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <radialGradient id="lampLight" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fef08a" stop-opacity="0.8" />
      <stop offset="40%" stop-color="#fbbf24" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#fbbf24" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
      <stop offset="40%" stop-color="#bae6fd" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Deep Night Sky -->
  <rect width="800" height="600" fill="url(#nightSky)" />

  <!-- Stars -->
  <circle cx="120" cy="80" r="1.5" fill="#ffffff" opacity="0.8" />
  <circle cx="280" cy="60" r="2.0" fill="#ffffff" opacity="0.9" />
  <circle cx="200" cy="140" r="1.2" fill="#bae6fd" opacity="0.7" />
  <circle cx="480" cy="90" r="1.8" fill="#ffffff" opacity="0.8" />
  <circle cx="650" cy="70" r="1.5" fill="#bae6fd" opacity="0.9" />
  <circle cx="720" cy="130" r="2.2" fill="#ffffff" opacity="0.95" />
  <circle cx="370" cy="120" r="1.2" fill="#ffffff" opacity="0.6" />
  <circle cx="560" cy="160" r="1.5" fill="#fde047" opacity="0.75" />
  <circle cx="150" cy="220" r="1.8" fill="#ffffff" opacity="0.8" />

  <!-- Crescent Moon with Glow -->
  <circle cx="640" cy="110" r="50" fill="url(#moonGlow)" />
  <path d="M 640,80 A 30,30 0 0 0 660,135 A 25,25 0 1 1 640,80 Z" fill="#fef9c3" />

  <!-- Cobblestone Ground / Silhouette Hills -->
  <path d="M 0,480 Q 250,450 500,470 T 800,460 L 800,600 L 0,600 Z" fill="#090d16" />
  <line x1="0" y1="480" x2="800" y2="460" stroke="#334155" stroke-width="1.5" opacity="0.4" />

  <!-- Distant City Skyline Silhouettes -->
  <polygon points="40,480 40,400 70,400 70,480" fill="#0c1322" />
  <polygon points="70,480 70,360 110,360 110,480" fill="#0c1322" />
  <polygon points="120,480 120,380 160,380 160,480" fill="#0c1322" />
  <polygon points="680,470 680,390 730,390 730,470" fill="#0c1322" />

  <!-- Glowing Street Lantern Post -->
  <line x1="320" y1="480" x2="320" y2="240" stroke="#475569" stroke-width="6" stroke-linecap="round" />
  <path d="M 320,240 Q 320,200 360,200 Q 400,200 400,230" fill="none" stroke="#475569" stroke-width="5" stroke-linecap="round" />
  <!-- Lantern Housing -->
  <polygon points="380,245 420,245 410,290 390,290" fill="#1e293b" stroke="#64748b" stroke-width="2" />
  <!-- Lantern Light Glow -->
  <circle cx="400" cy="270" r="160" fill="url(#lampLight)" />
  <circle cx="400" cy="265" r="12" fill="#fef08a" />

  <!-- Walking Couple Silhouette under lamp light -->
  <!-- Person 1 -->
  <circle cx="460" cy="420" r="9" fill="#1e293b" />
  <path d="M 452,432 L 468,432 L 472,480 L 450,480 Z" fill="#1e293b" />
  <!-- Person 2 -->
  <circle cx="482" cy="424" r="8" fill="#1e293b" />
  <path d="M 474,435 L 490,435 L 494,480 L 472,480 Z" fill="#1e293b" />

  <!-- Label Overlay Card -->
  <rect x="250" y="525" width="300" height="48" rx="24" fill="#090d16" opacity="0.8" stroke="#334155" stroke-width="1" />
  <text x="400" y="555" text-anchor="middle" fill="#bae6fd" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="300" letter-spacing="3">MIDNIGHT WALK MEMORY</text>
</svg>
